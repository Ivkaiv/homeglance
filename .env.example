# Homeglance configuration — скопируйте в .env.local и подправьте под себя.
# Все переменные опциональны.

# Порт, на котором запускается сервер.
# По умолчанию — 3040.
PORT=3040

# Путь к директории с server-storage (JSON-файлы с профилями, страницами, HA-токеном).
# По умолчанию — ./data в корне проекта. Обычно менять не нужно.
# DATA_DIR=./data

# Telemetry для Next.js — выключаем, чтобы ничего не отправлялось в Vercel.
NEXT_TELEMETRY_DISABLED=1
